# Copy to .env and fill in real values. .env is gitignored.

# Required: used by the embedding model (nvidia/nemotron-3-embed-1b:free via
# OpenRouter). Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

SECRET_KEY=dev-secret-key-change-me

# Required: MongoDB Atlas connection string (Atlas UI -> Connect -> Drivers).
# Vector search (`$vectorSearch`) needs a real Atlas cluster (or the
# mongodb/mongodb-atlas-local Docker image) -- plain community MongoDB can't
# run vector queries. (MONGODB_URI also works if you prefer that name.)
MONGO_DB_STRING=mongodb+srv://<user>:<password>@multi-user-rag.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=multi_user_rag
MONGODB_COLLECTION=transcript_chunks
MONGODB_VECTOR_INDEX=chunk_vector_index

# Optional: conversational RAG (POST /api/chat, backend/src/graph/). Both
# Groq and OpenRouter are OpenAI-API compatible; CHAT_PROVIDER picks which
# one serves chat completions ("groq" or "openrouter"). Only the matching
# <PROVIDER>_API_KEY / <PROVIDER>_BASE_URL pair below needs to be filled in.
CHAT_PROVIDER=groq

# Get a key at https://console.groq.com/keys. Model slugs:
# https://console.groq.com/docs/models.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter alternative -- reuses OPENROUTER_API_KEY above. Model slugs:
# https://openrouter.ai/models.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

CHAT_MODEL_NAME=llama-3.3-70b-versatile
MONGODB_HISTORY_COLLECTION=conversations
