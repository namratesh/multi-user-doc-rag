# Copy to .env and fill in real values. .env is gitignored.

# Required: used by the embedding model (nvidia/nemotron-3-embed-1b:free via
# OpenRouter). Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

SECRET_KEY=dev-secret-key-change-me

# Required: MongoDB Atlas connection string (Atlas UI -> Connect -> Drivers).
# Vector search (`$vectorSearch`) needs a real Atlas cluster (or the
# mongodb/mongodb-atlas-local Docker image) -- plain community MongoDB can't
# run vector queries. (MONGODB_URI also works if you prefer that name.)
MONGO_DB_STRING=mongodb+srv://<user>:<password>@multi-user-rag.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=multi_user_rag
MONGODB_COLLECTION=transcript_chunks
MONGODB_VECTOR_INDEX=chunk_vector_index
